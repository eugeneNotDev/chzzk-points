# 로컬 개발용 예시 파일 — 실제 값을 채운 .env는 절대 커밋하지 않는다.
# 시크릿(CHZZK_CLIENT_SECRET, SUPABASE_SERVICE_ROLE_KEY)은 여기 적더라도
# 로컬에서만 쓰고, 실제 운영값은 Supabase 프로젝트의 Edge Function 환경변수로만 등록한다.

# docs/assets/js/supabase-client.js 에 들어갈 값 (공개해도 되는 값)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# supabase/functions/oauth-callback 에서만 사용 (절대 프론트엔드로 노출 금지)
CHZZK_CLIENT_ID=
CHZZK_CLIENT_SECRET=
CHZZK_REDIRECT_URI=

# 자체 세션 토큰(JWT) 서명 비밀키. supabase/functions/_shared/session.ts 에서만 사용.
# 아무 랜덤 문자열이나 충분히 길게 (예: openssl rand -hex 32)
SESSION_JWT_SECRET=
