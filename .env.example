# 참고용 — 실제 값을 채운 .env는 절대 커밋하지 않는다.
# 운영 시크릿은 Supabase 대시보드의 Edge Function 환경변수(Secrets)에만 등록함.
# (사이트 쪽 공개 값 — Supabase URL·anon key·치지직 client id — 은 web/src/lib/config.ts에 들어 있음)

# oauth-callback 함수에서만 사용 (절대 프론트엔드로 노출 금지)
CHZZK_CLIENT_ID=
CHZZK_CLIENT_SECRET=
CHZZK_REDIRECT_URI=

# 자체 세션 토큰(JWT) 서명 비밀키 — supabase/functions/_shared/session.ts
# 충분히 긴 랜덤 문자열 (예: openssl rand -hex 32). 바꾸면 모든 로그인이 즉시 끊김
SESSION_JWT_SECRET=

# CORS 허용 도메인 (생략하면 https://eugene4lpha.com)
ALLOWED_ORIGIN=
